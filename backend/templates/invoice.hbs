<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <style>
    @page { size: A4; }

    /* Screen-only overrides (ignored by Puppeteer's print mode) */
    @media screen {
      html { background: #e8e8e8; overflow-x: hidden; }
      .page { box-shadow: 0 4px 24px rgba(0,0,0,.18); margin: 0 auto; }
    }

    :root {
      --accent: {{accentColor}};
      --text:   #1a1a1a;
      --muted:  #666;
      --border: #ddd;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: {{{fontFamily}}};
      font-size: 10pt;
      color: var(--text);
      background: white;
      width: 210mm;
    }

    /* ── Page shell ── */
    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 17mm 20mm 20mm 25mm;
      display: flex;
      flex-direction: column;
    }

    /* ── Header ── */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 10mm;
      min-height: 28mm;
    }

    .header-left {
      flex: 1;
      padding-top: 2mm;
      font-size: 9pt;
      color: var(--muted);
      white-space: pre-line;
    }

    .header-right {
      flex-shrink: 0;
      text-align: right;
      max-width: 75mm;
    }

    .logo {
      max-width: 65mm;
      max-height: 22mm;
      display: block;
      margin-left: auto;
      margin-bottom: 3.5mm;
    }

    .sender-details {
      font-size: 8.5pt;
      line-height: 1.6;
    }

    .sender-details .name {
      font-size: 9.5pt;
      font-weight: 700;
      display: block;
      margin-bottom: 0.5mm;
    }

    .sender-details .muted { color: var(--muted); }

    /* ── Sender strip (return address above envelope window, DIN 5008) ── */
    .sender-strip {
      font-size: 7pt;
      color: var(--muted);
      padding-bottom: 1.5mm;
      margin-bottom: 2mm;
      border-bottom: 0.4pt solid var(--border);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* ── Recipient window ── */
    .recipient {
      font-size: 10pt;
      line-height: 1.75;
      min-height: 35mm;
      margin-bottom: 9mm;
    }

    .recipient .company { font-weight: 600; }

    /* ── Reference row ── */
    .reference {
      display: flex;
      gap: 5mm;
      flex-wrap: wrap;
      margin-bottom: 8mm;
      padding-bottom: 4mm;
      border-bottom: 0.5pt solid var(--border);
      font-size: 8.5pt;
    }

    .ref-cell { flex: 1 1 30mm; }
    .ref-label { color: var(--muted); display: block; margin-bottom: 0.5mm; }
    .ref-value { font-weight: 600; }

    /* ── Document heading ── */
    h1 {
      font-size: 13pt;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 7mm;
      letter-spacing: 0.01em;
    }

    /* ── Line items table ── */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 3mm;
      font-size: 9.5pt;
    }

    .items-table thead tr { background: var(--accent); color: white; }

    .items-table th {
      padding: 2mm 3mm;
      text-align: left;
      font-weight: 600;
      font-size: 8pt;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .items-table th.r, .items-table td.r { text-align: right; }

    .items-table td {
      padding: 2.5mm 3mm;
      border-bottom: 0.3pt solid var(--border);
      vertical-align: top;
    }

    .items-table tbody tr:last-child td { border-bottom: none; }
    .items-table tbody tr:nth-child(even) td { background: #fafafa; }

    /* ── Totals block ── */
    .totals {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 9mm;
    }

    .totals-inner { width: 74mm; font-size: 9.5pt; padding-right: 3mm; }

    .total-row {
      display: flex;
      justify-content: space-between;
      padding: 1.2mm 0;
    }

    .total-row.subtotal {
      border-bottom: 0.3pt solid var(--border);
      padding-bottom: 2mm;
      margin-bottom: 1mm;
    }

    .total-label { color: var(--muted); }

    .total-row.grand {
      font-size: 11.5pt;
      font-weight: 700;
      color: var(--accent);
      border-top: 1.5pt solid var(--accent);
      margin-top: 2.5mm;
      padding-top: 3mm;
    }

    /* ── Info sections (payment, notes) ── */
    .section { margin-bottom: 7mm; font-size: 9.5pt; }

    .section-title {
      font-size: 8pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      margin-bottom: 2.5mm;
      padding-bottom: 1mm;
      border-bottom: 0.3pt solid var(--border);
    }

    .payment-grid {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1.5mm 6mm;
      align-items: baseline;
      line-height: 1.6;
    }

    .pay-label { color: var(--muted); font-size: 8.5pt; white-space: nowrap; }
    .pay-value { font-weight: 500; }
    .mono      { font-family: "DejaVu Sans Mono", "Courier New", monospace; font-size: 9pt; letter-spacing: 0.02em; }

    .notes-text {
      line-height: 1.7;
      color: #444;
      white-space: pre-wrap;
    }

    /* ── Letter ── */
    .letter {
      margin-bottom: 7mm;
      font-size: 10pt;
      line-height: 1.75;
      white-space: pre-wrap;
      color: var(--text);
    }

    /* ── Footer ── */
    .footer {
      margin-top: auto;
      padding-top: 4mm;
      border-top: 0.5pt solid var(--border);
      font-size: 7.5pt;
      color: var(--muted);
      text-align: center;
      line-height: 1.65;
      white-space: pre-line;
    }

    .page-break {
      position: absolute;
      left: 0; right: 0;
      height: 12px;
      pointer-events: none;
      z-index: 999;
      background: linear-gradient(to bottom, rgba(180,180,210,0.25) 0, transparent 100%);
      border-top: 1.5px dashed rgba(130,130,180,0.55);
    }

    @media print {
      .footer { display: none; }
      .page-break { display: none; }

      .page {
        padding-top: 1mm;
        padding-bottom: 0;
      }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- ══ Header ══ -->
  <div class="header">
    <div class="header-left">
      {{#if headerText}}<span>{{headerText}}</span>{{/if}}
    </div>
    <div class="header-right">
      {{#if logoDataUrl}}<img src="{{logoDataUrl}}" class="logo" alt="">{{/if}}
      <div class="sender-details">
        <span class="name">{{sellerName}}</span>
        {{#if sellerStreet}}{{sellerStreet}}<br>{{/if}}
        {{#if sellerPostalCode}}{{sellerPostalCode}} {{/if}}{{sellerCity}}{{#if sellerCountry}}, {{sellerCountry}}{{/if}}<br>
        {{#if sellerVatId}}<span class="muted">USt-IdNr.</span>&nbsp;{{sellerVatId}}<br>{{/if}}
        {{#if sellerTaxNumber}}<span class="muted">Steuernr.</span>&nbsp;{{sellerTaxNumber}}{{/if}}
      </div>
    </div>
  </div>

  <!-- ══ Sender strip ══ -->
  <div class="sender-strip">
    {{sellerName}}{{#if sellerStreet}}&nbsp;&middot;&nbsp;{{sellerStreet}}{{/if}}{{#if sellerPostalCode}}&nbsp;&middot;&nbsp;{{sellerPostalCode}} {{sellerCity}}{{/if}}
  </div>

  <!-- ══ Recipient window ══ -->
  <div class="recipient">
    {{#if buyerName}}<span class="company">{{buyerName}}</span><br>{{/if}}
    {{#if buyerStreet}}{{buyerStreet}}<br>{{/if}}
    {{buyerPostalCode}}{{#if buyerCity}} {{buyerCity}}{{/if}}<br>
    {{#if buyerCountry}}{{buyerCountry}}{{/if}}
  </div>

  <!-- ══ Reference row ══ -->
  <div class="reference">
    {{#if invoiceDate}}
    <div class="ref-cell">
      <span class="ref-label">Datum</span>
      <span class="ref-value">{{invoiceDate}}</span>
    </div>
    {{/if}}
    <div class="ref-cell">
      <span class="ref-label">Rechnungsnummer</span>
      <span class="ref-value">{{invoiceNumber}}</span>
    </div>
    {{#if dueDate}}
    <div class="ref-cell">
      <span class="ref-label">Fällig am</span>
      <span class="ref-value">{{dueDate}}</span>
    </div>
    {{/if}}
    {{#if buyerReference}}
    <div class="ref-cell">
      <span class="ref-label">Ihre Referenz</span>
      <span class="ref-value">{{buyerReference}}</span>
    </div>
    {{/if}}
  </div>

  <!-- ══ Heading ══ -->
  <h1>{{typeLabel}}&nbsp;{{invoiceNumber}}</h1>

  <!-- ══ Letter ══ -->
  {{#if letter}}
  <p class="letter">{{letter}}</p>
  {{/if}}

  <!-- ══ Line items ══ -->
  <table class="items-table">
    <thead>
      <tr>
        <th>Beschreibung</th>
        <th class="r">Menge</th>
        <th class="r">Einzelpreis</th>
        <th class="r">MwSt.</th>
        <th class="r">Betrag</th>
      </tr>
    </thead>
    <tbody>
      {{#each lineItems}}
      <tr>
        <td>{{description}}</td>
        <td class="r">{{quantity}}&nbsp;{{unitCode}}</td>
        <td class="r">{{unitPriceFormatted}}</td>
        <td class="r">{{vatRate}}&nbsp;%</td>
        <td class="r">{{lineTotalFormatted}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- ══ Totals ══ -->
  <div class="totals">
    <div class="totals-inner">
      <div class="total-row subtotal">
        <span class="total-label">Nettobetrag</span>
        <span>{{subtotalFormatted}}</span>
      </div>
      {{#each vatGroups}}
      <div class="total-row">
        <span class="total-label">MwSt.&nbsp;{{rate}}&nbsp;%</span>
        <span>{{taxFormatted}}</span>
      </div>
      {{/each}}
      <div class="total-row grand">
        <span>Gesamtbetrag</span>
        <span>{{grandTotalFormatted}}</span>
      </div>
    </div>
  </div>

  <!-- ══ Payment details ══ -->
  {{#if hasPaymentInfo}}
  <div class="section">
    <div class="section-title">Zahlungsinformationen</div>
    <div class="payment-grid">
      {{#if iban}}<span class="pay-label">IBAN</span><span class="pay-value mono">{{iban}}</span>{{/if}}
      {{#if bic}}<span class="pay-label">BIC</span><span class="pay-value mono">{{bic}}</span>{{/if}}
      {{#if paymentReference}}<span class="pay-label">Verwendungszweck</span><span class="pay-value">{{paymentReference}}</span>{{/if}}
      {{#if paymentTerms}}<span class="pay-label">Zahlungsbedingungen</span><span class="pay-value">{{paymentTerms}}</span>{{/if}}
    </div>
  </div>
  {{/if}}

  <!-- ══ Notes ══ -->
  {{#if notes}}
  <div class="section">
    <div class="section-title">Hinweise</div>
    <p class="notes-text">{{notes}}</p>
  </div>
  {{/if}}

  <!-- ══ Footer ══ -->
  <div class="footer">
    {{#if footerText}}{{footerText}}{{else}}PDF/A-3b &middot; Factur-X 1.0 &middot; {{profile}} &middot; Eingebettetes XML{{/if}}
  </div>

</div>
<script>
(function () {
  var PX_PER_MM = 96 / 25.4;
  var pageHeightPx = 297 * PX_PER_MM;
  var page = document.querySelector('.page');
  if (!page) return;
  page.style.position = 'relative';
  var totalHeight = page.scrollHeight;
  for (var y = pageHeightPx; y < totalHeight; y += pageHeightPx) {
    var marker = document.createElement('div');
    marker.className = 'page-break';
    marker.style.top = Math.round(y) + 'px';
    page.appendChild(marker);
  }
})();
</script>
</body>
</html>
